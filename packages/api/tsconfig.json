{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"],
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "paths": {
      "#*": ["./src/*"],
      "@repro/data/*": ["../data/src/*"],
      "@repro/payment/*": ["../payment/src/*"],
      "@repro/schema/*": ["../schema/src/*"],
      "@repro/service/*": ["../service/src/*"],
      "@repro/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["next-env.d.ts"]
}
