{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "unicorn"],
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true,
    "es2022": true,
    "node": true
  },
  "ignorePatterns": ["**/dist/**", "**/.vercel/**", "**/node_modules/**"],
  "rules": {
    "typescript/no-unsafe-type-assertion": "off"
  }
}
